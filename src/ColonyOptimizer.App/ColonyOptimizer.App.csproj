<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ColonyOptimizer.Core\ColonyOptimizer.Core.csproj" />
    <ProjectReference Include="..\ColonyOptimizer.GameData\ColonyOptimizer.GameData.csproj" />
    <ProjectReference Include="..\ColonyOptimizer.Optimization\ColonyOptimizer.Optimization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ColonyOptimizerLogo.png" />
    <Resource Include="Assets\ColonyOptimizerLogo.ico" />
    <Content Include="Assets\Visualisation\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ColonyOptimizer</AssemblyName>
    <ApplicationIcon>Assets\ColonyOptimizerLogo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
