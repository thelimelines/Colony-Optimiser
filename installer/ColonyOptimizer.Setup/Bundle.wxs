<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="$(var.ProductDisplayName)"
      Manufacturer="$(var.ProductPublisher)"
      Version="$(var.Version)"
      UpgradeCode="92E92929-141A-484D-B0B4-9B744B559F6C">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://opensource.org/license/mit/" />
    </BootstrapperApplication>
    <util:RegistrySearch
        Id="WebView2RuntimeMachineVersion"
        Variable="WebView2RuntimeMachineVersion"
        Root="HKLM"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="value" />
    <util:RegistrySearch
        Id="WebView2RuntimeUserVersion"
        Variable="WebView2RuntimeUserVersion"
        Root="HKCU"
        Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="value" />
    <Chain>
      <ExePackage
          SourceFile="$(var.WebView2RuntimeInstallerPath)"
          DetectCondition="WebView2RuntimeMachineVersion OR WebView2RuntimeUserVersion"
          InstallArguments="/silent /install"
          Permanent="yes"
          PerMachine="yes" />
      <MsiPackage SourceFile="$(var.MsiPath)" />
    </Chain>
  </Bundle>
</Wix>
